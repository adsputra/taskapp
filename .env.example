# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase project URL + anon key (safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public origin of the app, used for links in emails (invitations) and
# auth redirects. Required in production for invitation emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Social sign-in buttons to show, comma separated: google,github
# Each provider must also be enabled in Supabase → Authentication → Providers.
NEXT_PUBLIC_AUTH_PROVIDERS=

# Optional: send board invitations by email through Resend
# (https://resend.com). Without these the UI shows a link to copy instead.
RESEND_API_KEY=
INVITE_EMAIL_FROM="Tuesday <invites@your-domain.com>"

# Log verbosity: debug | info | warn | error (default: info)
LOG_LEVEL=info

# Rate limiting keys on the client IP. Name the header your edge ALWAYS
# overwrites (never one a client could send through untouched):
#   Vercel: x-vercel-forwarded-for   Cloudflare: cf-connecting-ip
#   nginx:  x-real-ip (with proxy_set_header X-Real-IP $remote_addr)
# Unset = rightmost X-Forwarded-For entry (correct behind exactly one proxy).
TRUSTED_IP_HEADER=

# Optional: Upstash Redis REST for rate limiting across instances.
# Without these, the rate limiter falls back to in-process memory.
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Optional: Bearer token for GET /api/metrics. When unset the endpoint
# returns 404, so metrics are never exposed publicly by accident.
METRICS_TOKEN=your-metrics-token
